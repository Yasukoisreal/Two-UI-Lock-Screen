<phone:PhoneApplicationPage
    x:Class="Two_UI_Lock_Screen.LockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    SupportedOrientations="Portrait" Orientation="Portrait"
    FontFamily="{StaticResource SamsungSans}"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0"
    shell:SystemTray.ForegroundColor="#FFFFFE">

    <phone:PhoneApplicationPage.Resources>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Black"
          ManipulationStarted="LayoutRoot_ManipulationStarted"
          ManipulationDelta="LayoutRoot_ManipulationDelta"
          ManipulationCompleted="LayoutRoot_ManipulationCompleted">

        <!-- Layer 1: Background Wallpaper (VRAM-cached bitmap, decoupled position) -->
        <Border x:Name="BackgroundContainer" CacheMode="BitmapCache">
            <Border.RenderTransform>
                <CompositeTransform x:Name="BackgroundTransform" />
            </Border.RenderTransform>
            <Border.Background>
                <ImageBrush x:Name="BackgroundBrush" Stretch="UniformToFill" />
            </Border.Background>

            <!-- Lớp phủ làm tối nhẹ giúp chữ và widget nổi bật chuẩn One UI 6.1 -->
            <Rectangle x:Name="DimOverlay" Fill="#12000000" />
        </Border>

        <!-- Layer 1b: Background Video (Samsung One UI 6.1 Live Video Wallpaper) -->
        <Grid x:Name="VideoContainer" Visibility="Collapsed">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="VideoTransform" />
            </Grid.RenderTransform>
            <MediaElement x:Name="WallpaperVideo"
                          Stretch="UniformToFill"
                          AutoPlay="True"
                          Volume="0"
                          MediaEnded="WallpaperVideo_MediaEnded"
                          MediaFailed="WallpaperVideo_MediaFailed" />
            <!-- Lớp phủ làm tối nhẹ giúp chữ và widget nổi bật chuẩn One UI 6.1 -->
            <Rectangle Fill="#12000000" />
        </Grid>

        <!-- Layer 2: Transformable Foreground Panel (Vuốt tay làm trượt và mờ lớp này) -->
        <Grid x:Name="ForegroundPanel">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="ForegroundTransform" />
            </Grid.RenderTransform>

            <!-- CỤM ĐỒNG HỒ & TYPOGRAPHY ONE UI 6.1 (Upper Section) -->
            <StackPanel x:Name="ClockContainer" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,44,0,0">
                <!-- Icon Ổ khóa One UI chính thức -->
                <Image x:Name="LockGlyphIcon" Source="/Assets/Icons/ic_lock.png" Width="15" Height="15" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.9" />

                <!-- Kiểu 1: Đồng hồ số 1 dòng ngang (12:39 - Mặc định One UI 6.1) -->
                <TextBlock x:Name="ClassicClockText" Text="12:39" FontSize="88" FontWeight="Normal"
                           FontFamily="{StaticResource SamsungSansMedium}" HorizontalAlignment="Center"
                           Foreground="#FFFFFE" Margin="0,-8,0,-4" />

                <!-- Kiểu 2: Đồng hồ số xếp chồng 2 dòng (Giờ trên, Phút dưới) -->
                <StackPanel x:Name="StackedClockPanel" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="HourText" Text="12" FontSize="86" FontWeight="Normal"
                               FontFamily="{StaticResource SamsungSansMedium}" HorizontalAlignment="Center"
                               Foreground="#FFFFFE" Margin="0,-12,0,-20" />
                    <TextBlock x:Name="MinuteText" Text="39" FontSize="86" FontWeight="Normal"
                               FontFamily="{StaticResource SamsungSansMedium}" HorizontalAlignment="Center"
                               Foreground="#FFFFFE" Margin="0,-16,0,0" />
                </StackPanel>

                <!-- Dòng Thứ, Ngày tháng + Thời tiết (Dòng 1 - Căn giữa) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock x:Name="SolarDateText" Text="T.4, 7 Th10" FontSize="16" FontWeight="Normal"
                               FontFamily="{StaticResource SamsungSans}" Foreground="#FFFFFE" VerticalAlignment="Center" />
                    <!-- Icon điều kiện thời tiết One UI (Mây mưa chuẩn xác) -->
                    <Image x:Name="WeatherHeaderIcon" Source="/Assets/Icons/ic_weather_cloud_rain.png" Width="18" Height="18"
                           VerticalAlignment="Center" Margin="9,0,4,0" Visibility="Collapsed" />
                    <TextBlock x:Name="WeatherText" Text="" FontSize="16" FontWeight="Normal"
                               FontFamily="{StaticResource SamsungSans}" Foreground="#FFFFFE" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>

                <!-- Dòng Âm lịch Việt Nam (Dòng 2 - Căn giữa chuẩn Samsung One UI) -->
                <TextBlock x:Name="LunarDateText" Text="(27 Th 8 ÂL)" FontSize="15"
                           FontFamily="{StaticResource SamsungSans}" Foreground="#D8FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />

                <!-- KHAY WIDGETS ONE UI 6.1: 3 Ô SQUIRCLE ĐỘC LẬP TÁCH BIỆT (KÍNH MỜ FROSTED GLASS) -->
                <StackPanel x:Name="WidgetsPillBar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <!-- Ô 1: Widget Pin điện thoại (Tile 1) -->
                    <Border x:Name="BatteryTileBorder" Width="68" Height="68" CornerRadius="18" Background="#2BFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                        <Border.RenderTransform>
                            <CompositeTransform CenterX="34" CenterY="34" />
                        </Border.RenderTransform>
                        <Grid Width="68" Height="68">
                            <!-- Vòng đo pin bán nguyệt nền (Cung móng ngựa 260 độ) -->
                            <Path Stroke="#35FFFFFF" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 18.68,41.86 A 20,20 0 1 1 49.32,41.86" />
                            <!-- Vòng đo pin bán nguyệt tiến độ -->
                            <Path x:Name="BatteryArcProgress" Stroke="#FFFFFE" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 18.68,41.86 A 20,20 0 0 1 34.0,9.0" />
                            <!-- Icon điện thoại Silhouette chuẩn One UI ở tâm -->
                            <Image Source="/Assets/Icons/ic_phone_glyph.png" Width="13" Height="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <TextBlock x:Name="BatteryWidgetIcon" Text="⚡" FontSize="11" Foreground="#FFFFFE" VerticalAlignment="Center" Margin="0,0,1,0" />
                                <TextBlock x:Name="BatteryPercentText" Text="100" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource SamsungSansMedium}" Foreground="#FFFFFE" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ô 2: Widget UV Index (Tile 2) -->
                    <Border x:Name="UvTileBorder" Width="68" Height="68" CornerRadius="18" Background="#2BFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                        <Border.RenderTransform>
                            <CompositeTransform CenterX="34" CenterY="34" />
                        </Border.RenderTransform>
                        <Grid Width="68" Height="68">
                            <!-- Vòng đo UV bán nguyệt nền (Cung móng ngựa 260 độ) -->
                            <Path Stroke="#35FFFFFF" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 18.68,41.86 A 20,20 0 1 1 49.32,41.86" />
                            <!-- Vòng đo UV bán nguyệt tiến độ (Dynamic UV arc) -->
                            <Path x:Name="UvArcProgress" Stroke="#FFFFFE" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 18.68,41.86 A 20,20 0 0 1 19.0,41.0" />
                            <!-- Icon mặt trời One UI UV ở tâm -->
                            <Image Source="/Assets/Icons/ic_sun_uv.png" Width="22" Height="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                            <TextBlock x:Name="UvIndexText" Text="0" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource SamsungSansMedium}" Foreground="#FFFFFE"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </Grid>
                    </Border>

                    <!-- Ô 3: Widget Thời tiết chi tiết (Tile 3) -->
                    <Border x:Name="WeatherTileBorder" Width="144" Height="68" CornerRadius="18" Background="#2BFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12,8,12,8">
                        <Border.RenderTransform>
                            <CompositeTransform CenterX="72" CenterY="34" />
                        </Border.RenderTransform>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LocationText" Text="" FontSize="13" Foreground="#D8FFFFFF"
                                           FontFamily="{StaticResource SamsungSans}" />
                                <TextBlock x:Name="WidgetTempText" Text="" FontSize="20" FontWeight="Normal"
                                           FontFamily="{StaticResource SamsungSansMedium}" Foreground="#FFFFFE" Margin="0,1,0,0" />
                            </StackPanel>
                            <!-- Icon luồng gió Samsung One UI chuẩn xác bên phải -->
                            <Image Grid.Column="1" Source="/Assets/Icons/ic_weather_wind.png" Width="36" Height="26"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- TIỆN ÍCH PHÁT NHẠC SAMSUNG ONE UI 6.1 (LISTEN TOGETHER SYNC) -->
                <Border x:Name="MusicWidgetCard" Width="432" Height="82" CornerRadius="24" Margin="0,12,0,0"
                        Background="#D018222A" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        Visibility="Collapsed" Tap="MusicWidgetCard_Tap">
                    <Grid>
                        <!-- Chế độ Mở rộng: Nền ảnh bìa mờ phóng to tràn viền phủ toàn bộ card -->
                        <Border x:Name="MusicExpandedBg" CornerRadius="24" Opacity="0" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="MusicBgBrush" Stretch="UniformToFill">
                                    <ImageBrush.Transform>
                                        <CompositeTransform x:Name="MusicBgTransform" ScaleX="1.25" ScaleY="1.25" CenterX="216" CenterY="92" />
                                    </ImageBrush.Transform>
                                </ImageBrush>
                            </Border.Background>
                            <!-- Lớp phủ tối mờ bo cong 24 chuẩn chỉnh triệt tiêu hoàn toàn mảng xám vuông ở góc -->
                            <Border x:Name="MusicExpandedBgOverlay" CornerRadius="24" Background="#85121820" />
                        </Border>

                        <!-- Ảnh bìa album vuông bo góc 14 phóng to 56×56 chuẩn One UI 6.1 (Thu gọn) -->
                        <Border x:Name="MusicThumbBorderCollapsed" Width="56" Height="56" CornerRadius="14"
                                Margin="16,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#30FFFFFF">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,56,56" RadiusX="14" RadiusY="14" />
                            </Border.Clip>
                            <Rectangle Width="56" Height="56">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="MusicCoverBrushCollapsed" Stretch="UniformToFill"
                                                AlignmentX="Center" AlignmentY="Center" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>

                        <!-- Cột thông tin: '♪ Điện thoại này' + Tên bài hát + Nghệ sĩ (Di chuyển sang trái đè lên ảnh bìa khi mở rộng) -->
                        <StackPanel x:Name="MusicCollapsedInfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="84,13,0,0">
                            <StackPanel.RenderTransform>
                                <CompositeTransform x:Name="MusicCollapsedInfoTransform" />
                            </StackPanel.RenderTransform>
                            <!-- Hàng 1: Icon nốt nhạc / App icon + 'Điện thoại này' -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Image x:Name="MusicAppIconCollapsed" Stretch="Uniform" Visibility="Collapsed" />
                                    <TextBlock x:Name="MusicAppGlyphCollapsed" Text="&#xE189;" FontFamily="Segoe UI Symbol" FontSize="10" Foreground="#C0D0DC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="MusicAudioOutputCollapsed" Text="Điện thoại này" FontSize="11.5" Foreground="#C0D0DC"
                                           FontFamily="{StaticResource SamsungSans}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Hàng 2: Tên bài hát -->
                            <TextBlock x:Name="MusicTitleCollapsed" Text="Chưa phát nhạc" FontSize="16" FontWeight="SemiBold"
                                       FontFamily="{StaticResource SamsungSansMedium}" Foreground="#FFFFFE"
                                       TextTrimming="WordEllipsis" MaxWidth="230" Margin="0,6,0,2" />
                            <!-- Hàng 3: Nghệ sĩ -->
                            <TextBlock x:Name="MusicArtistCollapsed" Text="YTMusicWP" FontSize="12.5" Foreground="#A0B0BC"
                                       FontFamily="{StaticResource SamsungSans}" TextTrimming="WordEllipsis" MaxWidth="230" />
                        </StackPanel>

                        <!-- Cụm 3 nút điều khiển (Thu gọn: Lùi, Play/Pause, Chuyển bài) cố định không di chuyển, chỉ fade out -->
                        <StackPanel x:Name="MusicCollapsedControls" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,30,16,0">
                            <StackPanel.RenderTransform>
                                <CompositeTransform x:Name="MusicCollapsedControlsTransform" />
                            </StackPanel.RenderTransform>
                            <!-- Nút Lùi bài -->
                            <Border x:Name="MusicPrevBtnCollapsed" Width="32" Height="34" Background="Transparent" Tap="MusicPrev_Tap">
                                <TextBlock Text="&#xE100;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#FFFFFE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Nút Play/Pause -->
                            <Border x:Name="MusicPlayPauseBtnCollapsed" Width="36" Height="34" Background="Transparent" Tap="MusicPlayPause_Tap" Margin="4,0,4,0">
                                <TextBlock x:Name="MusicPlayPauseIconCollapsed" Text="&#xE103;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#FFFFFE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Nút Chuyển bài -->
                            <Border x:Name="MusicNextBtnCollapsed" Width="32" Height="34" Background="Transparent" Tap="MusicNext_Tap">
                                <TextBlock Text="&#xE101;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#FFFFFE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Pill 'Đầu ra media' ở góc trên bên phải (Trượt sang trái và fade in khi mở rộng) -->
                        <Border x:Name="MusicMediaOutputPill" Height="22" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Background="#35FFFFFF" CornerRadius="11" Padding="10,0,10,0" Margin="0,13,42,0"
                                Opacity="0" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="MusicMediaOutputTransform" TranslateX="25" />
                            </Border.RenderTransform>
                            <TextBlock Text="Đầu ra media" FontSize="11" Foreground="#FFFFFE" FontFamily="{StaticResource SamsungSans}" VerticalAlignment="Center" />
                        </Border>

                        <!-- NÚT MŨI TÊN ĐIỀU HƯỚNG GÓC TRÊN BÊN PHẢI (Xoay chuẩn xác tại đầu nhọn mũi tên) -->
                        <Border x:Name="MusicArrowBtn" Width="32" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,8,0" Background="Transparent"
                                Tap="MusicArrow_Tap">
                            <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="MusicArrowTransform" CenterX="8" CenterY="8" Rotation="0" />
                                </Grid.RenderTransform>
                                <Path x:Name="MusicArrowPath" Data="M 2.5,2.5 L 8,8 L 13.5,2.5" Stroke="#C0FFFFFF" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- GIAO DIỆN MỞ RỘNG (EXPANDED VIEW): Thanh seekbar và 5 nút điều khiển lớn cố định, chỉ fade in -->
                        <Grid x:Name="MusicExpandedView" Visibility="Collapsed" Opacity="0" Margin="16,78,16,0" VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="MusicExpandedTransform" />
                            </Grid.RenderTransform>
                            <StackPanel>
                                <!-- Thanh tiến trình Seekbar & Mốc thời gian chuẩn One UI 6.1 (Tròn hoàn toàn 12x12) -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Track bar container: Chiều cao 34px, cung cấp khoảng trống rộng rãi phía trên cho 2 lớp sóng biển nhô cao mà không bị cắt mép -->
                                    <Grid x:Name="MusicSeekbarContainer" Height="34" Background="Transparent"
                                          SizeChanged="MusicSeekbarContainer_SizeChanged" Tap="MusicSeekbarContainer_Tap">
                                        <!-- Rãnh nền kính mờ chưa phát (Dày 10px từ Y=18 đến Y=28, CornerRadius 5 chuẩn Samsung One UI 6.1) -->
                                        <Border Height="10" CornerRadius="5" Background="#45FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Stretch" />
                                        <!-- Rãnh tải đệm (Buffer Progress) màu trắng mờ chuẩn AOSP -->
                                        <Border x:Name="MusicSeekBufferedTrack" Height="10" CornerRadius="5" Background="#55FFFFFF"
                                                VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Left" Width="0" />
                                        <!-- Rãnh tiến độ đã phát màu pastel sáng (Lớp đệm mút tròn ở đầu và phẳng khi tạm dừng) -->
                                        <Border x:Name="MusicSeekPlayedTrack" Height="10" CornerRadius="5" Background="#F0FFFFFF"
                                                VerticalAlignment="Top" Margin="0,18,0,0" HorizontalAlignment="Left" Width="0" />
                                        <!-- Rãnh tiến độ dạng sóng biển One UI 6.1 khi đang phát nhạc (2 lớp sóng biển chồng lên nhau) -->
                                        <Canvas x:Name="MusicSeekWaveCanvas" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Visibility="Collapsed">
                                            <!-- Đệm tròn bo mép trái: ẩn vì cung tròn ArcSegment được tích hợp trực tiếp vào hình học vector sóng -->
                                            <Border x:Name="MusicSeekWaveLeftCap" Width="10" Height="10" CornerRadius="5" Background="#F0FFFFFF" Canvas.Left="0" Canvas.Top="18" Visibility="Collapsed" />
                                            <!-- 1. Sóng biển lớn phía sau: sóng lớn hơn, trôi chậm hơn, màu trắng/pastel sáng nguyên khối -->
                                            <Path x:Name="MusicSeekWaveBackPath" Fill="#F5FFFFFF" />
                                            <!-- 2. Sóng biển nhỏ phía trước: sóng nhỏ hơn, trôi nhanh hơn, bán trong suốt tinh tế -->
                                            <Path x:Name="MusicSeekWaveFrontPath" Fill="#B0BACEE0" />
                                        </Canvas>
                                        <!-- Nút trượt One UI Thumb tròn xoe 18x18 bo tròn 9, tâm trục khớp tại Y=23 cùng tâm rãnh -->
                                        <Border x:Name="MusicSeekThumb" Width="18" Height="18" CornerRadius="9" Background="#F8E2F1FD"
                                                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                    </Grid>

                                    <!-- Mốc thời gian phút:giây 2 bên: Căn đều 0px bằng chuẩn xác với 2 đầu thanh seekbar, tăng cỡ chữ lên 12 -->
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock x:Name="MusicCurrentTimeText" Text="00:00" FontSize="12" Foreground="#B0C0CC"
                                                   FontFamily="{StaticResource SamsungSans}" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="MusicTotalTimeText" Text="00:00" FontSize="12" Foreground="#B0C0CC"
                                                   FontFamily="{StaticResource SamsungSans}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>

                                <!-- Hàng 5 nút điều khiển dưới cùng: Trái tim, Lùi, Play/Pause, Kế tiếp, Shuffle (Khoảng cách gọn gàng chuẩn One UI) -->
                                <Grid Width="300" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 1. Nút tùy biến bên trái (Slot 1: Mặc định Yêu thích) -->
                                    <Border x:Name="MusicLeftActionBtn" Grid.Column="0" Height="34" Background="Transparent" Tap="MusicFavorite_Tap">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="MusicLeftActionImage" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed" />
                                            <TextBlock x:Name="MusicHeartIcon" Text="&#xE006;" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="#FFFFFE"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <!-- 2. Lùi bài -->
                                    <Border x:Name="MusicPrevBtnExpanded" Grid.Column="1" Height="34" Background="Transparent" Tap="MusicPrev_Tap">
                                        <TextBlock Text="&#xE100;" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="#FFFFFE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 3. Play/Pause -->
                                    <Border x:Name="MusicPlayPauseBtnExpanded" Grid.Column="2" Height="34" Background="Transparent" Tap="MusicPlayPause_Tap">
                                        <TextBlock x:Name="MusicPlayPauseIconExpanded" Text="&#xE103;" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="#FFFFFE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 4. Kế tiếp -->
                                    <Border x:Name="MusicNextBtnExpanded" Grid.Column="3" Height="34" Background="Transparent" Tap="MusicNext_Tap">
                                        <TextBlock Text="&#xE101;" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="#FFFFFE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 5. Nút tùy biến bên phải (Slot 5: Mặc định Trộn bài) -->
                                    <Border x:Name="MusicRightActionBtn" Grid.Column="4" Height="34" Background="Transparent" Tap="MusicShuffle_Tap">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="MusicRightActionImage" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed" />
                                            <TextBlock x:Name="MusicShuffleIcon" Text="&#xE148;" FontFamily="Segoe UI Symbol" FontSize="17" Foreground="#FFFFFE"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>


                <!-- HÀNG THÔNG BÁO ONE UI 6.1 (TRANSPARENT NOTIFICATION ROW) -->
                <StackPanel x:Name="NotificationContainer" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="NotificationIconsRow">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,0,6,0">
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Huy hiệu số đếm thông báo One UI (Pill nhỏ cyan bo tròn ở góc trên) -->
                                    <Border Background="#CBE7FF" CornerRadius="6" Padding="3,0,3,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,-5,-6,0"
                                            Visibility="{Binding CounterVisibility}">
                                        <TextBlock Text="{Binding Counter}" FontSize="9" FontWeight="Bold"
                                                   FontFamily="{StaticResource SamsungSansMedium}" Foreground="#1A1C1E" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thông báo chi tiết (nếu có) -->
                    <TextBlock x:Name="NotificationDetailedText" FontSize="13" Foreground="#CCFFFFFF"
                               FontFamily="{StaticResource SamsungSans}" HorizontalAlignment="Center"
                               TextTrimming="WordEllipsis" MaxWidth="380" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <!-- KHU VỰC THÔNG TIN PIN / SẠC DƯỚI ĐÁY KHI CẮM SẠC -->
            <StackPanel x:Name="BottomChargingPanel" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,45" Visibility="Collapsed"
                        Tap="BottomInfo_Tap">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image x:Name="BottomBatteryImage" Source="/Assets/Icons/ic_battery_bolt.png"
                           Width="13" Height="18" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock x:Name="BottomBatteryPercent" Text="35%" FontSize="15" FontWeight="SemiBold"
                               FontFamily="{StaticResource SamsungSansMedium}" Foreground="#FFFFFE" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="BottomChargingEstimateText" Text="4 giờ 55 phút nữa sẽ đầy" FontSize="13"
                           FontFamily="{StaticResource SamsungSans}" Foreground="#D5FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- THÔNG TIN DANH BẠ KHI KHÔNG SẠC ("Yasuko" - Plain Text sạch sẽ sát đáy) -->
            <TextBlock x:Name="ContactText" Text="Yasuko" FontSize="14"
                       FontFamily="{StaticResource SamsungSansMedium}" Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,45"
                       Tap="BottomInfo_Tap" />

            <!-- HAI PHÍM TẮT GÓC DƯỚI (One UI 6.1 Squircle Siêu Elip Bo Mập Mạp 50x50) -->
            <!-- Nút Trái: Đèn pin (Torch) -->
            <Border x:Name="LeftShortcutButton" Width="50" Height="50"
                    Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"
                    ManipulationStarted="LeftShortcut_ManipulationStarted"
                    ManipulationDelta="LeftShortcut_ManipulationDelta"
                    ManipulationCompleted="LeftShortcut_ManipulationCompleted">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="LeftShortcutTransform" CenterX="25" CenterY="25" />
                </Border.RenderTransform>
                <Image x:Name="LeftShortcutImage" Source="/Assets/Icons/ic_shortcut_flash.png"
                       Width="50" Height="50" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Nút Phải: Máy ảnh (Camera) -->
            <Border x:Name="RightShortcutButton" Width="50" Height="50"
                    Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                    ManipulationStarted="RightShortcut_ManipulationStarted"
                    ManipulationDelta="RightShortcut_ManipulationDelta"
                    ManipulationCompleted="RightShortcut_ManipulationCompleted">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="RightShortcutTransform" CenterX="25" CenterY="25" />
                </Border.RenderTransform>
                <Image x:Name="RightShortcutImage" Source="/Assets/Icons/ic_shortcut_camera.png"
                       Width="50" Height="50" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Lớp phủ làm tối màn hình khóa khi vuốt phím tắt One UI 6.1 -->
        <Rectangle x:Name="ShortcutDimOverlay" Fill="Black" Opacity="0.0"
                   IsHitTestVisible="False" Visibility="Collapsed"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Khung chứa bảng vuốt phím tắt One UI 6.1 có clip cắt viền theo mép màn hình -->
        <Grid x:Name="ShortcutSwipeContainer" IsHitTestVisible="False">
            <Grid.Clip>
                <RectangleGeometry x:Name="ShortcutClipGeometry" Rect="0,0,480,900" />
            </Grid.Clip>

            <!-- Bảng nền đen mờ vuốt phím tắt Đèn pin (Trái: Dọc thân máy One UI 6.1) -->
            <Border x:Name="TorchSwipePanel" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Height="720" Width="480" CornerRadius="0,80,80,0"
                    Background="#F00B0E14" Opacity="0.0" Visibility="Collapsed">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="TorchSwipePanelTransform" TranslateX="-480" />
                </Border.RenderTransform>
                <Image x:Name="TorchSwipeIcon" Source="/Assets/Icons/ic_shortcut_flash_white.png"
                       Width="64" Height="64" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,160,0"
                       Opacity="0.35">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="TorchSwipeIconTransform" CenterX="32" CenterY="32" ScaleX="1.0" ScaleY="1.0" />
                    </Image.RenderTransform>
                </Image>
            </Border>

            <!-- Bảng nền đen mờ vuốt phím tắt Máy ảnh (Phải: Dọc thân máy One UI 6.1) -->
            <Border x:Name="CameraSwipePanel" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="720" Width="480" CornerRadius="80,0,0,80"
                    Background="#F00B0E14" Opacity="0.0" Visibility="Collapsed">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="CameraSwipePanelTransform" TranslateX="480" />
                </Border.RenderTransform>
                <Image x:Name="CameraSwipeIcon" Source="/Assets/Icons/ic_shortcut_camera_white.png"
                       Width="64" Height="64" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="160,0,0,0"
                       Opacity="0.35">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="CameraSwipeIconTransform" CenterX="32" CenterY="32" ScaleX="1.0" ScaleY="1.0" />
                    </Image.RenderTransform>
                </Image>
            </Border>
        </Grid>

        <!-- Layer 3: In-process Quick Camera Viewfinder Overlay (Samsung One UI 6.1 Camera) -->
        <Grid x:Name="CameraOverlay" Visibility="Collapsed" Background="Black">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="CameraOverlayTransform" CenterX="440" CenterY="760" />
            </Grid.RenderTransform>

            <!-- 1. Kính ngắm máy ảnh trực tiếp (Live Viewfinder Surface) -->
            <Canvas x:Name="CameraViewfinderCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Tap="CameraViewfinder_Tap">
                <Canvas.Background>
                    <VideoBrush x:Name="CameraVideoBrush" Stretch="UniformToFill">
                        <VideoBrush.RelativeTransform>
                            <CompositeTransform x:Name="CameraBrushTransform" CenterX="0.5" CenterY="0.5" Rotation="90" />
                        </VideoBrush.RelativeTransform>
                    </VideoBrush>
                </Canvas.Background>
            </Canvas>

            <!-- 2. Vòng tròn lấy nét vàng One UI (Focus Indicator Ring) -->
            <Canvas x:Name="CameraFocusCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                <Grid x:Name="CameraFocusRing" Width="68" Height="68" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="CameraFocusTransform" CenterX="34" CenterY="34" />
                    </Grid.RenderTransform>
                    <Ellipse Stroke="#FFDF00" StrokeThickness="2.5" />
                    <Ellipse Width="6" Height="6" Fill="#FFDF00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Canvas>

            <!-- 3. Màn chớp trắng khi chụp ảnh (White Shutter Flash) -->
            <Rectangle x:Name="CameraShutterFlash" Fill="White" Opacity="0.0" Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- 4. Thanh điều khiển phía trên (Top Controls Bar) -->
            <Grid VerticalAlignment="Top" Margin="16,36,16,0">
                <!-- Nút Flash (Auto / Bật / Tắt) -->
                <Border x:Name="CameraFlashBtn" Background="#35000000" CornerRadius="18" Padding="12,6"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Tap="CameraFlash_Tap">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CameraFlashIcon" Text="⚡" FontSize="15" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="CameraFlashText" Text="Tự động" FontSize="13" Foreground="White"
                                   FontFamily="{StaticResource SamsungSansMedium}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Dòng trạng thái Toast nhỏ thông báo (ví dụ "Đang chụp...", "Đã lưu ảnh") -->
                <Border x:Name="CameraStatusPill" Background="#50000000" CornerRadius="12" Padding="10,4"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CameraStatusText" Text="Đã lưu vào Bộ sưu tập" FontSize="12" Foreground="White"
                               FontFamily="{StaticResource SamsungSans}" />
                </Border>

                <!-- Nút Đóng máy ảnh ✕ trở lại màn hình khóa -->
                <Border Background="#35000000" Width="38" Height="38" CornerRadius="19"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Tap="CloseCamera_Tap">
                    <TextBlock Text="✕" FontSize="17" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                </Border>
            </Grid>

            <!-- 5. Thanh điều khiển chụp phía dưới chuẩn Samsung One UI 6.1 (Bottom Shutter Bar) -->
            <Grid VerticalAlignment="Bottom" Margin="0,0,0,32" Height="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Ảnh thu nhỏ vừa chụp (Thumbnail Preview) -->
                <Border x:Name="CameraThumbBorder" Width="48" Height="48" CornerRadius="24"
                        Background="#25FFFFFF" BorderBrush="#50FFFFFF" BorderThickness="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Tap="CameraThumb_Tap">
                    <Grid>
                        <Image x:Name="CameraThumbImage" Stretch="UniformToFill" Width="48" Height="48">
                            <Image.Clip>
                                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                            </Image.Clip>
                        </Image>
                        <!-- Icon mặc định khi chưa chụp ảnh (Vector Gallery / Pictures) -->
                        <Viewbox x:Name="CameraThumbEmptyIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="#D0FFFFFF" Data="M2,4 C2,2.9 2.9,2 4,2 L18,2 C19.1,2 20,2.9 20,4 L20,18 C20,19.1 19.1,20 18,20 L4,20 C2.9,20 2,19.1 2,18 Z M4,17 L18,17 L13.5,11 L10,15.5 L7.5,12.5 Z M6.5,8 C7.33,8 8,7.33 8,6.5 C8,5.67 7.33,5 6.5,5 C5.67,5 5,5.67 5,6.5 C5,7.33 5.67,8 6.5,8 Z" />
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- Cột giữa: Nút chụp ảnh Samsung One UI 6.1 (White Shutter Circle 74x74) -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Tap="CameraShutter_Tap">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="CameraShutterTransform" CenterX="37" CenterY="37" />
                    </Grid.RenderTransform>
                    <!-- Vòng ngoài 74x74 viền trắng 4px bo tròn 37 -->
                    <Border Width="74" Height="74" CornerRadius="37" BorderBrush="White" BorderThickness="4" />
                    <!-- Lõi trong 58x58 trắng nguyên khối -->
                    <Border Width="58" Height="58" CornerRadius="29" Background="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Cột phải: Nút Đổi Camera trước / sau chuẩn Samsung One UI (Vector Flip Arrows) -->
                <Border x:Name="CameraFlipBtn" Grid.Column="2" Width="48" Height="48" CornerRadius="24"
                        Background="#35000000" BorderBrush="#25FFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Tap="CameraFlip_Tap">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="White" Data="M12,4 L12,1 L8,5 L12,9 L12,6 C15.31,6 18,8.69 18,12 C18,13.01 17.75,13.97 17.3,14.8 L18.8,16.3 C19.55,15.05 20,13.58 20,12 C20,7.58 16.42,4 12,4 Z M12,18 C8.69,18 6,15.31 6,12 C6,10.99 6.25,10.03 6.7,9.2 L5.2,7.7 C4.45,8.95 4,10.42 4,12 C4,16.42 7.58,20 12,20 L12,23 L16,19 L12,15 Z" />
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
