<phone:PhoneApplicationPage
    x:Class="Two_UI_Lock_Screen.RoamingClockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource SamsungSans}"
    FontSize="15"
    Foreground="#FFFFFE"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0"
    shell:SystemTray.ForegroundColor="#FFFFFE">

    <phone:PhoneApplicationPage.Resources>
        <!-- Style công tắc One UI Toggle Switch -->
        <Style x:Key="OneUiToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <Border x:Name="TrackOff" Width="46" Height="26" CornerRadius="13" Background="#38383A" />
                            <Border x:Name="TrackOn" Width="46" Height="26" CornerRadius="13" Background="#6BA5E7" Opacity="0" />
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFE"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="#000000">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="PageRootTransform" />
        </Grid.RenderTransform>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,30">

                <!-- 1. THANH TIÊU ĐỀ ONE UI CHUẨN (< Đồng hồ chuyển vùng) -->
                <Grid Margin="18,48,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Nút Quay lại góc trái: Biểu tượng < chuẩn One UI -->
                    <Border x:Name="BackNavButton" Width="40" Height="40" HorizontalAlignment="Left" Background="Transparent" Tap="BackNav_Tap">
                        <Grid>
                            <Border x:Name="BackNav_Ripple" Background="#24FFFFFF" CornerRadius="20" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Path Data="M 16,10 L 8,20 L 16,30" Stroke="#A3CBEE" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <TranslateTransform Y="-4" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Đồng hồ chuyển vùng" FontSize="23" FontWeight="SemiBold"
                               FontFamily="{StaticResource SamsungSansMedium}" Foreground="#A3CBEE"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <!-- 2. THẺ BẬT / TẮT (Bật) -->
                <Border Background="#1C1C20" CornerRadius="22" Margin="16,0,16,10" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bật" FontSize="16.5" Foreground="#FFFFFE" VerticalAlignment="Center" />
                        <CheckBox x:Name="RoamingClockSwitch" Grid.Column="1" Style="{StaticResource OneUiToggleSwitchStyle}"
                                  Click="RoamingClockSwitch_Click" />
                    </Grid>
                </Border>

                <!-- Dòng mô tả dưới thẻ Bật -->
                <TextBlock Text="Hiển thị cả giờ tại vị trí của bạn và giờ tại nhà khi bạn đang chuyển vùng."
                           FontSize="13" Foreground="#8E8E93" TextWrapping="Wrap" Margin="32,0,32,24" />

                <!-- 3. MÚI GIỜ ĐỊA PHƯƠNG -->
                <StackPanel Margin="32,0,32,24">
                    <TextBlock Text="Múi giờ địa phương" FontSize="16" Foreground="#FFFFFE" />
                    <TextBlock Text="TP Hồ Chí Minh (GMT+07:00)" FontSize="13.5" Foreground="#70A6DE" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 4. THẺ KHU VỰC -->
                <Grid Margin="16,0,16,10" x:Name="RowRegion">
                    <Border Background="#1C1C20" CornerRadius="22" />
                    <Border x:Name="Region_Ripple" Background="#24FFFFFF" CornerRadius="22" Opacity="0" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="0" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel Margin="18,14">
                        <TextBlock Text="Khu vực" FontSize="16.5" Foreground="#FFFFFE" />
                        <TextBlock Text="Việt Nam" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Dòng mô tả múi giờ -->
                <TextBlock Text="Sử dụng Giờ Đông Dương (GMT+07:00). Không sử dụng giờ theo mùa."
                           FontSize="13" Foreground="#8E8E93" TextWrapping="Wrap" Margin="32,0,32,24" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
