<Application
    x:Class="Two_UI_Lock_Screen.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone">

    <!--Application Resources-->
    <Application.Resources>
        <local:LocalizedStrings xmlns:local="clr-namespace:Two_UI_Lock_Screen" x:Key="LocalizedStrings"/>
        <FontFamily x:Key="SamsungSans">/Two UI Lock Screen;component/Assets/Fonts/SamsungSans-Regular.ttf#Samsung Sans, /Two%20UI%20Lock%20Screen;component/Assets/Fonts/SamsungSans-Regular.ttf#Samsung Sans, /Assets/Fonts/SamsungSans-Regular.ttf#Samsung Sans, Samsung Sans</FontFamily>
        <FontFamily x:Key="SamsungSansMedium">/Two UI Lock Screen;component/Assets/Fonts/SamsungSans-Medium.ttf#Samsung Sans, /Two%20UI%20Lock%20Screen;component/Assets/Fonts/SamsungSans-Medium.ttf#Samsung Sans, /Assets/Fonts/SamsungSans-Medium.ttf#Samsung Sans, Samsung Sans</FontFamily>
        <FontFamily x:Key="SamsungSansBold">/Two UI Lock Screen;component/Assets/Fonts/SamsungSans-Bold.ttf#Samsung Sans, /Two%20UI%20Lock%20Screen;component/Assets/Fonts/SamsungSans-Bold.ttf#Samsung Sans, /Assets/Fonts/SamsungSans-Bold.ttf#Samsung Sans, Samsung Sans</FontFamily>
    </Application.Resources>

    <Application.ApplicationLifetimeObjects>
        <!--Required object that handles lifetime events for the application-->
        <shell:PhoneApplicationService
            Launching="Application_Launching" Closing="Application_Closing"
            Activated="Application_Activated" Deactivated="Application_Deactivated"/>
    </Application.ApplicationLifetimeObjects>

</Application>