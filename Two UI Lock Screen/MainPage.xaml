<phone:PhoneApplicationPage
    x:Class="Two_UI_Lock_Screen.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource SamsungSans}"
    FontSize="15"
    Foreground="#FFFFFE"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0"
    shell:SystemTray.ForegroundColor="#FFFFFE">

    <phone:PhoneApplicationPage.Resources>
        <!-- Style công tắc One UI Toggle Switch (Pill bo tròn, viên tròn trượt mượt mà) -->
        <Style x:Key="OneUiToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" Background="Transparent">
                            <!-- Rãnh công tắc khi TẮT (#38383A) -->
                            <Border x:Name="TrackOff" Width="46" Height="26" CornerRadius="13" Background="#38383A" />
                            <!-- Rãnh công tắc khi BẬT (#6BA5E7 - Xanh One UI) -->
                            <Border x:Name="TrackOn" Width="46" Height="26" CornerRadius="13" Background="#6BA5E7" Opacity="0" />
                            <!-- Nút gạt tròn trắng (#FFFFFE) -->
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFE"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="#000000">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="PageRootTransform" />
        </Grid.RenderTransform>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,40">

                <!-- 1. TIÊU ĐỀ LỚN ONE UI (EXPANDED COLLAPSIBLE HEADER) -->
                <StackPanel Margin="0,55,0,16">
                    <TextBlock Text="Màn hình khóa" FontSize="32" FontWeight="Normal"
                               Foreground="#A3CBEE" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 2. THANH ĐIỀU HƯỚNG VÀ TÌM KIẾM DƯỚI TIÊU ĐỀ (< và 🔍) -->
                <Grid Margin="18,0,18,18">
                    <!-- Nút Quay lại góc trái: Biểu tượng < chuẩn One UI -->
                    <Border x:Name="BackNavButton" Width="40" Height="40" HorizontalAlignment="Left" Background="Transparent" Tap="BackNav_Tap">
                        <Grid>
                            <Border x:Name="BackNav_Ripple" Background="#24FFFFFF" CornerRadius="20" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Path Data="M 16,10 L 8,20 L 16,30" Stroke="#FFFFFE" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Nút Tìm kiếm góc phải: Kính lúp 🔍 chuẩn One UI -->
                    <Border x:Name="SearchNavButton" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Tap="SearchNav_Tap">
                        <Grid>
                            <Border x:Name="SearchNav_Ripple" Background="#24FFFFFF" CornerRadius="20" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Path Data="M 18,13 A 6,6 0 1 1 6,13 A 6,6 0 1 1 18,13 M 17,17 L 23,23"
                                  Stroke="#FFFFFE" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. THẺ LIVE LOCK SCREEN CỐT LÕI (CORE LIVE LOCK SCREEN CARD) -->
                <Border Background="#1C1C20" CornerRadius="22" Margin="16,0,16,14">
                    <StackPanel>
                        <!-- Mục 1: Kích hoạt Live Lock Screen -->
                        <Grid x:Name="RowActiveLock">
                            <Border x:Name="ActiveLock_Ripple" Background="#24FFFFFF" CornerRadius="22,22,0,0" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kích hoạt Màn hình khóa" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock Text="Đăng ký làm màn hình khóa mở rộng của máy" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ActiveLockSwitch" Grid.Column="1" Style="{StaticResource OneUiToggleSwitchStyle}"
                                          Click="ActiveLockSwitch_Click" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 2: Xem trước Màn hình khóa -->
                        <Grid x:Name="RowPreviewLock" Background="Transparent" Tap="PreviewLock_Tap">
                            <Border x:Name="PreviewLock_Ripple" Background="#24FFFFFF" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Xem trước Màn hình khóa" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock Text="Mở trực tiếp giao diện màn hình khóa One UI 6.1" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <Path Grid.Column="1" Data="M 2,2 L 8,8 L 2,14" Stroke="#555558" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 3: Cài đặt Màn hình khóa hệ thống -->
                        <Grid x:Name="RowSystemLockSettings" Background="Transparent" Tap="SystemLockSettings_Tap">
                            <Border x:Name="SystemLockSettings_Ripple" Background="#24FFFFFF" CornerRadius="0,0,22,22" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cài đặt màn hình khóa của máy" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock Text="Mở cài đặt màn hình khóa trong Settings của điện thoại" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <Path Grid.Column="1" Data="M 2,2 L 8,8 L 2,14" Stroke="#555558" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. THẺ TÙY CHỈNH MÀN HÌNH KHÓA (CHUẨN ẢNH CHỤP ONE UI) -->
                <Border Background="#1C1C20" CornerRadius="22" Margin="16,0,16,14">
                    <StackPanel>
                        <!-- Mục 1: Chạm và giữ để sửa -->
                        <Grid x:Name="RowTouchAndHold">
                            <Border x:Name="TouchAndHold_Ripple" Background="#24FFFFFF" CornerRadius="22,22,0,0" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chạm và giữ để sửa" FontSize="16.5" Foreground="#FFFFFE" VerticalAlignment="Center" />
                                <CheckBox x:Name="TouchAndHoldSwitch" Grid.Column="1" Style="{StaticResource OneUiToggleSwitchStyle}"
                                          Click="SettingChanged_Click" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 2: Âm lịch -->
                        <Grid x:Name="RowLunar">
                            <Border x:Name="Lunar_Ripple" Background="#24FFFFFF" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Âm lịch" FontSize="16.5" Foreground="#FFFFFE" VerticalAlignment="Center" />
                                <CheckBox x:Name="LunarSwitch" Grid.Column="1" Style="{StaticResource OneUiToggleSwitchStyle}"
                                          Click="SettingChanged_Click" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 3: Đồng hồ chuyển vùng (Thời tiết - Chuẩn One UI Split Switch) -->
                        <Grid x:Name="RowRoamingClock">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Nửa bên trái: Nhấn mở trang chi tiết Đồng hồ chuyển vùng -->
                                <Grid Grid.Column="0" x:Name="RowRoamingClockLeft" Background="Transparent" Tap="RoamingClockDetails_Tap">
                                    <Border x:Name="RoamingClock_Ripple" Background="#24FFFFFF" Opacity="0" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <CompositeTransform ScaleX="0" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="18,14,0,14">
                                        <TextBlock Text="Đồng hồ chuyển vùng" FontSize="16.5" Foreground="#FFFFFE" />
                                        <TextBlock Text="Hiển thị thời tiết và nhiệt độ địa phương" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Vạch ngăn cách dọc chuẩn Samsung One UI 6.1 -->
                                <Rectangle Grid.Column="1" Width="1" Height="22" Fill="#353538" Margin="14,0,14,0" VerticalAlignment="Center" />

                                <!-- Nửa bên phải: Công tắc bật/tắt nhanh -->
                                <CheckBox Grid.Column="2" x:Name="RoamingClockSwitch" Style="{StaticResource OneUiToggleSwitchStyle}"
                                          Margin="0,0,18,0" Click="SettingChanged_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 4: Widget -->
                        <Grid x:Name="RowWidget" Background="Transparent" Tap="WidgetDetails_Tap">
                            <Border x:Name="Widget_Ripple" Background="#24FFFFFF" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Widget" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock Text="Nhạc, Pin thiết bị, Thời tiết, Lịch..." FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <Path Grid.Column="1" Data="M 2,2 L 8,8 L 2,14" Stroke="#555558" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 4b: Thông báo -->
                        <Grid x:Name="RowNotification">
                            <Border x:Name="Notification_Ripple" Background="#24FFFFFF" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thông báo" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock Text="Hiển thị icon thông báo (cuộc gọi nhỡ, tin nhắn, app)" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="NotificationSwitch" Grid.Column="1" Style="{StaticResource OneUiToggleSwitchStyle}"
                                          Click="SettingChanged_Click" />
                            </Grid>
                        </Grid>

                        <Rectangle Height="1" Fill="#28282C" Margin="18,0,0,0" />

                        <!-- Mục 5: Kiểu đồng hồ -->
                        <Grid x:Name="RowClockStyle" Background="Transparent" Tap="ClockStyle_Tap">
                            <Border x:Name="ClockStyle_Ripple" Background="#24FFFFFF" CornerRadius="0,0,22,22" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kiểu đồng hồ" FontSize="16.5" Foreground="#FFFFFE" />
                                    <TextBlock x:Name="ClockStyleSubtitle" Text="Số ngang 1 dòng (12:06 - Mặc định)" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                                </StackPanel>
                                <Path Grid.Column="1" Data="M 2,2 L 8,8 L 2,14" Stroke="#555558" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- THẺ VIDEO NỀN (ONE UI LIVE VIDEO WALLPAPER - SPLIT SWITCH ITEM) -->
                <Border Background="#1C1C20" CornerRadius="22" Margin="16,0,16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Nửa bên trái: Nhấn để chọn tệp video nền -->
                        <Grid Grid.Column="0" x:Name="RowSelectVideo" Background="Transparent" Tap="SelectVideo_Tap">
                            <Border x:Name="SelectVideo_Ripple" Background="#24FFFFFF" CornerRadius="22,0,0,22" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="18,14,0,14">
                                <TextBlock Text="Video nền (Live Wallpaper)" FontSize="16.5" Foreground="#FFFFFE" />
                                <TextBlock x:Name="VideoWallpaperSubtitle" Text="Chưa chọn video (Hỗ trợ định dạng .mp4, .wmv)" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Vạch ngăn cách dọc chuẩn One UI 6.1 -->
                        <Rectangle Grid.Column="1" Width="1" Height="22" Fill="#353538" Margin="14,0,14,0" VerticalAlignment="Center" />

                        <!-- Nửa bên phải: Công tắc bật/tắt nhanh video nền -->
                        <CheckBox Grid.Column="2" x:Name="UseVideoWallpaperSwitch" Style="{StaticResource OneUiToggleSwitchStyle}"
                                  Margin="0,0,18,0" Click="UseVideoWallpaperSwitch_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>


                <!-- 5. THẺ THÔNG TIN MÀN HÌNH KHÓA (CHUẨN ẢNH CHỤP ONE UI 6.1) -->
                <Grid Margin="16,0,16,14" x:Name="RowAboutLockScreen" Background="Transparent" Tap="AboutLockScreen_Tap">
                    <Border Background="#1C1C20" CornerRadius="22" />
                    <Border x:Name="AboutLockScreen_Ripple" Background="#24FFFFFF" CornerRadius="22" Opacity="0" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="0" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock Text="Thông tin Màn hình khóa" FontSize="16.5" Foreground="#FFFFFE" VerticalAlignment="Center" Margin="18,18" />
                </Grid>

                <!-- 6. THẺ 'BẠN ĐANG TÌM KIẾM ĐIỀU GÌ KHÁC?' (CHUẨN ẢNH CHỤP ONE UI) -->
                <Border Background="#14181E" CornerRadius="22" Margin="16,4,16,14" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Bạn đang tìm kiếm điều gì khác?" FontSize="15"
                                   FontFamily="{StaticResource SamsungSansMedium}"
                                   Foreground="#FFFFFE" Margin="0,0,0,12" />

                        <!-- Sửa Màn hình khóa (Chọn hình nền / Đặt lại) -->
                        <Grid x:Name="RowEditLockScreen" Background="Transparent" Tap="EditLockScreen_Tap" Margin="0,3">
                            <Border x:Name="EditLockScreen_Ripple" Background="#24FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Text="Sửa Màn hình khóa" Foreground="#70A6DE" FontSize="15" Margin="6,4" />
                        </Grid>

                        <!-- Ẩn nội dung -->
                        <Grid x:Name="RowHideContent" Background="Transparent" Tap="HideContent_Tap" Margin="0,3">
                            <Border x:Name="HideContent_Ripple" Background="#24FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Text="Ẩn nội dung" Foreground="#70A6DE" FontSize="15" Margin="6,4" />
                        </Grid>

                        <!-- Thông báo cần hiển thị -->
                        <Grid x:Name="RowNotificationSettings" Background="Transparent" Tap="NotificationSettings_Tap" Margin="0,3">
                            <Border x:Name="NotificationSettings_Ripple" Background="#24FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock Text="Thông báo cần hiển thị" Foreground="#70A6DE" FontSize="15" Margin="6,4" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>