<phone:PhoneApplicationPage
    x:Class="Two_UI_Lock_Screen.AboutLockScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource SamsungSans}"
    FontSize="15"
    Foreground="#FFFFFE"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0"
    shell:SystemTray.ForegroundColor="#FFFFFE">

    <Grid x:Name="LayoutRoot" Background="#000000">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="PageRootTransform" />
        </Grid.RenderTransform>
        <!-- Top App Bar Navigation (< and (i)) -->
        <Grid VerticalAlignment="Top" Margin="18,48,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Nút Quay lại góc trái: < chuẩn One UI -->
            <Border x:Name="BackNavButton" Width="40" Height="40" HorizontalAlignment="Left" Background="Transparent" Tap="BackNav_Tap">
                <Grid>
                    <Border x:Name="BackNav_Ripple" Background="#24FFFFFF" CornerRadius="20" Opacity="0" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="0" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                    <Path Data="M 16,10 L 8,20 L 16,30" Stroke="#FFFFFE" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Nút Info (i) góc phải chuẩn One UI -->
            <Border x:Name="AppDetailsButton" Grid.Column="2" Width="40" Height="40" HorizontalAlignment="Right" Background="Transparent" Tap="AppDetails_Tap">
                <Grid>
                    <Border x:Name="AppDetails_Ripple" Background="#24FFFFFF" CornerRadius="20" Opacity="0" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <CompositeTransform ScaleX="0" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                    <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Stroke="#FFFFFE" StrokeThickness="1.8" />
                        <TextBlock Text="i" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource SamsungSansBold}"
                                   Foreground="#FFFFFE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Khối thông tin trung tâm (Màn hình khóa + Phiên bản) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-60,0,0">
            <TextBlock Text="Màn hình khóa" FontSize="30" FontWeight="SemiBold"
                       FontFamily="{StaticResource SamsungSansMedium}"
                       Foreground="#8DBBF0" HorizontalAlignment="Center" />

            <TextBlock x:Name="VersionText" Text="Phiên bản 8.7.98.45" FontSize="14.5"
                       Foreground="#D0D0D5" HorizontalAlignment="Center" Margin="0,18,0,4" />

            <TextBlock Text="Phiên bản mới nhất đã được cài đặt." FontSize="13.5"
                       Foreground="#8E8E93" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Nút Giấy phép nguồn mở dưới đáy -->
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40"
              x:Name="BtnOpenSourceLicenses" Background="Transparent" Tap="OpenSourceLicenses_Tap">
            <Border Background="#242428" CornerRadius="22" />
            <Border x:Name="OpenSourceLicenses_Ripple" Background="#24FFFFFF" CornerRadius="22" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <CompositeTransform ScaleX="0" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
            <Border Padding="26,12">
                <TextBlock Text="Giấy phép nguồn mở" FontSize="15" FontWeight="SemiBold"
                           FontFamily="{StaticResource SamsungSansMedium}"
                           Foreground="#FFFFFE" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
